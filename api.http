@baseUrl = http://localhost:8080
@contentType = application/json

### ==========================================
### Add Hall — happy path (expect 201 Created)
### ==========================================
POST {{baseUrl}}/api/halls
Content-Type: {{contentType}}

{
  "name": "Зал D",
  "capacity": 40,
  "costPerHour": 1800,
  "amenityIds": [1, 2]
}

### ==========================================
### Add Hall — invalid amenity id (expect 400)
### ==========================================
POST {{baseUrl}}/api/halls
Content-Type: {{contentType}}

{
  "name": "Зал E",
  "capacity": 20,
  "costPerHour": 1000,
  "amenityIds": [999]
}

### ==========================================
### Add Hall — duplicate name (expect 409)
### ==========================================
POST {{baseUrl}}/api/halls
Content-Type: {{contentType}}

{
  "name": "Зал А",
  "capacity": 50,
  "costPerHour": 2000,
  "amenityIds": []
}

### ==========================================
### Get Hall by ID — happy path (expect 200)
### ==========================================
GET {{baseUrl}}/api/halls/1
Accept: {{contentType}}

### ==========================================
### Update Hall — happy path (expect 204 or 200)
### ==========================================
PUT {{baseUrl}}/api/halls/1
Content-Type: {{contentType}}

{
  "name": "Зал А (оновлений)",
  "capacity": 55,
  "cost": 2100,
  "amenityIds": [1, 3]
}

### ==========================================
### Update Hall — partial update (only capacity)
### ==========================================
PUT {{baseUrl}}/api/halls/1
Content-Type: {{contentType}}

{
  "capacity": 60
}

### ==========================================
### Update Hall — not found (expect 404)
### ==========================================
PUT {{baseUrl}}/api/halls/9999
Content-Type: {{contentType}}

{
  "name": "Неіснуючий зал"
}

### ==========================================
### Search Available Halls — happy path
### ==========================================
POST {{baseUrl}}/api/halls/search
Content-Type: {{contentType}}

{
  "startTime": "2026-10-01T10:00:00Z",
  "endTime": "2026-10-01T12:00:00Z",
  "capacity": 30
}

### ==========================================
### Search Available Halls — invalid time range (expect 400)
### ==========================================
POST {{baseUrl}}/api/halls/search
Content-Type: {{contentType}}

{
  "startTime": "2026-10-01T12:00:00Z",
  "endTime": "2026-10-01T10:00:00Z",
  "capacity": 30
}

### ==========================================
### Search Available Halls — past time (expect 400)
### ==========================================
POST {{baseUrl}}/api/halls/search
Content-Type: {{contentType}}

{
  "startTime": "2020-01-01T10:00:00Z",
  "endTime": "2020-01-01T12:00:00Z",
  "capacity": 30
}

### ==========================================
### Book Hall — happy path (expect 201 Created)
### ==========================================
POST {{baseUrl}}/api/halls/1/bookings
Content-Type: {{contentType}}

{
  "date": "2026-10-05T14:00:00Z",
  "durationMinutes": 120,
  "amenityIds": [1, 3]
}

### ==========================================
### Book Hall — no amenities
### ==========================================
POST {{baseUrl}}/api/halls/1/bookings
Content-Type: {{contentType}}

{
  "date": "2026-10-06T09:00:00Z",
  "durationMinutes": 60,
  "amenityIds": []
}

### ==========================================
### Book Hall — conflicting time slot (expect 409)
### ==========================================
POST {{baseUrl}}/api/halls/1/bookings
Content-Type: {{contentType}}

{
  "date": "2026-10-05T14:30:00Z",
  "durationMinutes": 30,
  "amenityIds": []
}

### ==========================================
### Book Hall — invalid amenity (expect 400)
### ==========================================
POST {{baseUrl}}/api/halls/1/bookings
Content-Type: {{contentType}}

{
  "date": "2026-10-07T10:00:00Z",
  "durationMinutes": 60,
  "amenityIds": [999]
}

### ==========================================
### Book Hall — hall not found (expect 404)
### ==========================================
POST {{baseUrl}}/api/halls/9999/bookings
Content-Type: {{contentType}}

{
  "date": "2026-10-05T14:00:00Z",
  "durationMinutes": 60,
  "amenityIds": []
}

### ==========================================
### PRICING TESTS — verify discount/charge frames
### ==========================================

### Morning band (06:00–09:00) — expect ×0.90
POST {{baseUrl}}/api/halls/1/bookings
Content-Type: {{contentType}}

{
  "date": "2026-10-08T06:00:00Z",
  "durationMinutes": 60,
  "amenityIds": []
}

### Standard hours, no band match (09:00–18:00 outside 12–14) — expect ×1.0
POST {{baseUrl}}/api/halls/1/bookings
Content-Type: {{contentType}}

{
  "date": "2026-10-08T10:00:00Z",
  "durationMinutes": 60,
  "amenityIds": []
}

### Peak band (12:00–14:00) — expect ×1.15 surcharge
POST {{baseUrl}}/api/halls/1/bookings
Content-Type: {{contentType}}

{
  "date": "2026-10-08T12:00:00Z",
  "durationMinutes": 60,
  "amenityIds": []
}

### Evening band (18:00–23:00) — expect ×0.80
POST {{baseUrl}}/api/halls/1/bookings
Content-Type: {{contentType}}

{
  "date": "2026-10-08T19:00:00Z",
  "durationMinutes": 120,
  "amenityIds": []
}

### Spans across a band boundary (17:00–20:00, crosses 18:00) — expect ×1.0
POST {{baseUrl}}/api/halls/1/bookings
Content-Type: {{contentType}}

{
  "date": "2026-10-08T17:00:00Z",
  "durationMinutes": 180,
  "amenityIds": []
}

### Exceeds a band on the other side (13:00–15:00) — expect ×1.0
POST {{baseUrl}}/api/halls/1/bookings
Content-Type: {{contentType}}

{
  "date": "2026-10-08T13:00:00Z",
  "durationMinutes": 120,
  "amenityIds": []
}

### Morning band boundary (06:00–09:00 exactly) — expect ×0.90
POST {{baseUrl}}/api/halls/1/bookings
Content-Type: {{contentType}}

{
  "date": "2026-10-08T06:00:00Z",
  "durationMinutes": 180,
  "amenityIds": []
}

### ==========================================
### Delete Hall — happy path (expect 204)
### ==========================================
DELETE {{baseUrl}}/api/halls/2

### ==========================================
### Delete Hall — has active bookings (expect 409)
### ==========================================
DELETE {{baseUrl}}/api/halls/1

### ==========================================
### Delete Hall — not found (expect 404)
### ==========================================
DELETE {{baseUrl}}/api/halls/9999